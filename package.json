{
  "name": "format-flow",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-hosting.mjs",
    "build:next": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "npm run build",
