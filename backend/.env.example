SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
CORS_ORIGINS=https://jinsihousheshou.github.io,http://localhost:3000,http://127.0.0.1:3000
DIRECT_VIDEO_HOSTS=jinsihousheshou.github.io,developer.mozilla.org,media.w3.org
# 仅填写明确允许本站处理的公开音频/视频直链域名，不要使用 *。
DIRECT_MEDIA_HOSTS=jinsihousheshou.github.io,developer.mozilla.org,media.w3.org
TEMP_DIR=/tmp/format-flow
MAX_CONCURRENT_PARSES=2
MAX_CONCURRENT_DOWNLOADS=2
PARSE_TIMEOUT_SECONDS=45
DOWNLOAD_TIMEOUT_SECONDS=600
JOB_TTL_SECONDS=1800
# 本地 FFmpeg 不在 PATH 时填写；Docker 部署无需设置。
FFMPEG_LOCATION=
