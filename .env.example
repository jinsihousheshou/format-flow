# 百度统计「管理 -> 代码获取」中 hm.js? 后面的站点 ID
NEXT_PUBLIC_BAIDU_TONGJI_ID=

# Supabase 项目设置 -> API。这里只能填写公开的 anon key，严禁填写 service_role。
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# 独立 FastAPI 视频后端的公开 HTTPS 根地址。生产环境严禁填写 localhost。
NEXT_PUBLIC_VIDEO_API_URL=https://YOUR_VIDEO_API_HOST

# 可选：闲鱼商品页，只在构建时注入前端。
NEXT_PUBLIC_XIANYU_URL=
